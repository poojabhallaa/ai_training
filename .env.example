# Copy to .env (local) or .env.production (build) and fill in.
# These values are bundled into the public site. Never put secrets here.

# Web app URL of the deployed Apps Script (ends in /exec).
# For local testing without Google, run `npm run mock:backend` and use:
#   VITE_APPS_SCRIPT_URL=http://localhost:8787/exec
VITE_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Optional: base path when hosting under a sub-path, e.g. GitHub Pages
# project sites (https://<user>.github.io/<repo>/). Defaults to "/".
# VITE_BASE_PATH=/your-repo-name/
